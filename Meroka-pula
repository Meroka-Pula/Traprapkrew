/* Global Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #e8d9b5;
    color: #333;
    line-height: 1.6;
}

/* Navigation */
nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 5%;
    background-color: rgba(0, 0, 0, 0.8);
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    color: #f0e3b2;
    font-weight: 700;
    font-size: 1.5rem;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    margin-left: 2rem;
}

nav ul li a {
    color: #f0e3b2;
    text-decoration: none;
    transition: 0.3s;
}

nav ul li a:hover {
    color: #d9c14a;
}

/* Banners */
.banner {
    height: 10px;
    width: 100%;
}

.red {
    background-color: #e74c3c;
}

.blue {
    background-color: #3498db;
}

.yellow {
    background-color: #f1c40f;
}

/* Sections */
section {
    padding: 4rem 5%;
    min-height: 100vh;
}

.home-section {
    background-color: #f0e3b2;
}

/* Bio Content */
.bio-content {
    max-width: 800px;
    margin: 2rem auto;
    padding: 2rem;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
}

.bio-content h1 {
    color: #895b29;
    margin-bottom: 1.5rem;
    text-align: center;
}

.bio-content p {
    margin-bottom: 1rem;
    color: #333;
}

/* Gallery */
.gallery {
    margin-top: 3rem;
}

.gallery h2 {
    text-align: center;
    color: #895b29;
    margin-bottom: 2rem;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
}

.gallery-item {
    height: 250px;
    background-color: #d9c14a;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #333;
    font-weight: bold;
    border-radius: 8px;
    transition: transform 0.3s;
}

.gallery-item:hover {
    transform: scale(1.03);
}

/* Music Section */
.music-section {
    background-color: #c68b39;
    text-align: center;
}

.music-section h2 {
    color: #f0e3b2;
    margin-bottom: 2rem;
}

.music-links {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
}

.music-btn {
    display: inline-block;
    padding: 1rem 2rem;
    background-color: #3498db;
    color: white;
    text-decoration: none;
    border-radius: 50px;
    transition: 0.3s;
}

.music-btn:hover {
    background-color: #2980b9;
    transform: translateY(-3px);
}

/* Projects Section */
.projects-section {
    background-color: #a25a2a;
}

.projects-section h2 {
    color: #f0e3b2;
    text-align: center;
    margin-bottom: 2rem;
}

.project-card {
    background-color: #f0e3b2;
    padding: 2rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    max-width: 800px;
    margin: 0 auto 1.5rem;
}

.project-card h3 {
    color: #895b29;
    margin-bottom: 0.5rem;
}

/* Contact Section */
.contact-section {
    background-color: #895b29;
    text-align: center;
}

.contact-section h2 {
    color: #f0e3b2;
    margin-bottom: 2rem;
}

form {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

form input,
form textarea {
    padding: 1rem;
    border: none;
    border-radius: 5px;
}

form button {
    padding: 1rem;
    background-color: #d9c14a;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    transition: 0.3s;
}

form button:hover {
    background-color: #c68b39;
    color: white;
}

.social-links {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
}

.social-links a {
    color: #f0e3b2;
    font-size: 2rem;
    transition: 0.3s;
}

.social-links a:hover {
    color: #d9c14a;
}

