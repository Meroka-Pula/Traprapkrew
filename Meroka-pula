<body>
<!-- Navigation Menu -->
    <nav>
        <div class="logo">MEROKA-PULA</div>
        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#music">Music</a></li>
            <li><a href="#projects">Projects</a></li>
            <li><a href="#gallery">Gallery</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- Home Section -->
    <section id="home" class="home-section">
        <div class="banner red"></div>
        <div class="banner blue"></div>
        <div class="banner yellow"></div>
        
        <div class="bio-content">
            <h1>MEROKA-PULA</h1>
            <p>Meroka-Pula is an indie duo group of music artists, songwriters, and creative editors hailing from Berea, Thuathe. Its members are Kabelo Sidwell "Trxkky" Moshesha (23, BA Broadcasting & Journalism student) and Nkoma "Jay Slot" Lihaso (24).</p>
            
            <p>Since 2018, we've pioneered Sotho trap music - a sub-genre under hip hop. We were part of Project Qamako, collaborating with Pitso Ramakhula, Origin Band, Ntate Stunna, and Age Law under Phillip "Phil Vigilante" Mofoka.</p>
            
            <p>In 2022, we released our debut EP "Lithoko tsa Pula", recorded at Khotla la Pina Records and Optimistik Music Stable. Currently working on our debut album "MEROKA-PULA Vol 1" to showcase New Age Hip Hop from Lesotho to the world.</p>
        </div>

        <!-- Gallery Section -->
        <div id="gallery" class="gallery">
            <h2>GALLERY</h2>
            <div class="gallery-grid">
                <div class="gallery-item">[Performance Photo 1]</div>
                <div class="gallery-item">[Studio Session]</div>
                <div class="gallery-item">[Album Cover]</div>
                <div class="gallery-item">[Live Show]</div>
                <div class="gallery-item">[Collaboration]</div>
                <div class="gallery-item">[Behind Scenes]</div>
            </div>
        </div>
    </section>

    <!-- Music Section -->
    <section id="music" class="music-section">
        <h2>OUR MUSIC</h2>
        <div class="music-links">
            <a href="https://audiomack.com/traprapkrew-meroka-pula" target="_blank" class="music-btn">
                <i class="fas fa-music"></i> Audiomack
            </a>
            <a href="https://lesmusic.co/traprapkew-meroka-pula" target="_blank" class="music-btn">
                <i class="fas fa-compact-disc"></i> Lesmusic
            </a>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="projects-section">
        <h2>PROJECTS</h2>
        <div class="project-card">
            <h3>Lithoko tsa Pula (2022)</h3>
            <p>Debut EP produced by Khotla la Pina Record and Optimistik Music Stable</p>
        </div>
        <div class="project-card">
            <h3>MEROKA-PULA Vol 1 (Coming Soon)</h3>
            <p>Boundary-breaking debut album showcasing New Age Hip Hop from Lesotho</p>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact-section">
        <h2>CONTACT US</h2>
        <form>
            <input type="text" placeholder="Name">
            <input type="email" placeholder="Email">
            <input type="text" placeholder="Subject">
            <textarea placeholder="Message"></textarea>
            <button type="submit">Send Message</button>
        </form>
        <div class="social-links">
            <a href="https://m.facebook.com/traprapkrew-meroka-pula" target="_blank"><i class="fab fa-facebook"></i></a>
            <a href="#"><i class="fab fa-instagram"></i></a>
            <a href="mailto:merokapula@example.com"><i class="fas fa-envelope"></i></a>
        </div>
    </section>

    <footer>
        <p>&copy; 2023 MEROKA-PULA | #SOTHOTRAP #TRAPRAPKREW</p>
    </footer>
</body>
